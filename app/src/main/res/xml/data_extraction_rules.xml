<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Backups also require the in-app "Android backup" switch (see AppBackupAgent). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
