<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="@color/widget_foreground"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/widget_text"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/shortcut_text"
        android:src="@drawable/ic_edit" />

    <ImageButton
        android:id="@+id/widget_voice"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/shortcut_voice"
        android:src="@drawable/ic_mic" />
</LinearLayout>
